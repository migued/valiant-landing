---
import ItemText from './ItemText.astro';
import GradientButton from './GradientButton.astro';

const audienceItems = [
	'<strong>Eres asesor inmobiliario</strong> — Y quieres usar IA para generar guiones de seguimiento, anuncios que te consigan citas y contenido que te posicione como referente sin depender de agencias.',
	'<strong>Eres desarrollador</strong> — Y quieres crear anuncios, campañas y presentaciones con IA que posicionen mejor tus proyectos y aceleren tus ventas.',
	'<strong>Diriges una inmobiliaria</strong> — Y quieres que tu equipo produzca más marketing, mejores copies y mejores anuncios usando IA sin que tú tengas que estar encima de todo.',
	'<strong>Si eres flipper</strong> — Y quieres analizar pre-ofertas más rápido, crear propuestas irresistibles y lanzar campañas que roten tus propiedades sin frenar tu flujo de capital.',
];
---

<section class="container audience">
	<div class="audience-content">
		<h2 class="audience-headline">
			¿Para quién es la <span class="audience-gradient">membres-IA</span>?
		</h2>

		<div class="audience-highlight-box">
			<p class="audience-highlight-text">
				Es para inmobiliarios que quieren convertir la Inteligencia Artificial en producción, más posicionamiento y más ingresos reales.
			</p>
		</div>

		<ItemText items={audienceItems} />

		<p class="audience-summary-label">En resumen...</p>
		<p class="audience-summary-text">
			<strong>Valiant club</strong> es entrenamiento práctico mensual para convertir la IA en una herramienta que te haga ganar <strong>tiempo, autoridad y dinero</strong>.
		</p>

		<div class="pricing-card">
			<span class="pricing-card-badge">Membres-IA</span>
			<h3 class="pricing-card-title">Valiant MembresIA</h3>
			<p class="pricing-card-desc">Para inmobiliarias con flujos comerciales activos que necesitan más potencia.</p>
			<p class="pricing-card-price"><span class="pricing-card-amount">$19</span> USD/mes</p>
			<GradientButton text="Empezar →" />
			<div class="pricing-card-features">
				<p class="pricing-card-features-title">PRINCIPALES FUNCIONES:</p>
				<ul class="pricing-card-list">
					<li>2 Clases mensuales</li>
					<li>Acceso a Valiant tools</li>
					<li>Acceso a grabaciones</li>
					<li>Acceso a la comunidad de inmobilIArios</li>
					<li>Actualización constante</li>
				</ul>
			</div>
		</div>
	</div>
</section>

<style>
	.audience-content {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
	}

	.audience-headline {
		font-size: 1.3rem;
		font-weight: 700;
		line-height: 1.2;
		text-align: center;
		margin: 0;
	}

	.audience-gradient {
		background: linear-gradient(90deg, #cdfdf8, #94b9ff);
		border-radius: 0.35em;
		padding: 0.1em 0.3em;
		color: #1a1a2e;
		font-weight: 700;
	}

	.audience-highlight-box {
		background: linear-gradient(90deg, #cdfdf8, #94b9ff);
		border-radius: 0.5rem;
		padding: 0.7rem 1rem;
		margin-top: 1.5rem;
		transform: rotate(-2deg);
		box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
		max-width: 670px;
	}

	.audience-highlight-text {
		color: black;
		font-weight: 700;
		font-size: 1rem;
		margin: 0;
		line-height: 1.4;
	}

	.audience-summary-label {
		margin: 3rem auto 0.25rem;
		font-size: 1.25rem;
		font-weight: 700;
		background-color: #38b6ff;
		color: #f8f8f8;
		padding: 0.3em 0.8em;
		border-radius: 0.35em;
		letter-spacing: 0.05em;
		text-transform: uppercase;
	}

	.audience-summary-text {
		margin: 0;
		font-size: 1.3rem;
		line-height: 1.3;
		text-align: center;
		max-width: 35ch;
	}

	@media (min-width: 768px) {
		.audience-headline {
			font-size: 2.5rem;
			max-width: 40ch;
		}

		.audience-highlight-text {
			font-size: 1.5rem;
		}

		.audience-summary-label {
			font-size: 1.7rem;
		}

		.audience-summary-text {
			font-size: 2rem;
			max-width: 30ch;
		}
	}

	.pricing-card {
		margin-top: 3rem;
		background: linear-gradient(180deg, #4642d8, #a29dff);
		border-radius: 1rem;
		padding: 2rem 1.5rem;
		max-width: 360px;
		width: 100%;
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: 0.5rem;
		box-shadow: 0 8px 30px rgba(0, 0, 0, 0.25);
	}

	.pricing-card-badge {
		background: linear-gradient(90deg, #cdfdf8, #94b9ff);
		color: #1a1a2e;
		font-weight: 700;
		font-size: 1.3rem;
		padding: 0.3em 1em;
		border-radius: 2em;
		margin-bottom: 0.5rem;
	}

	.pricing-card-title {
		color: #f8f8f8;
		font-size: 1.25rem;
		font-weight: 700;
		margin: 0;
	}

	.pricing-card-desc {
		color: #d0d0e0;
		font-size: 1rem;
		line-height: 1.4;
		margin: 0;
		max-width: 28ch;
	}

	.pricing-card-price {
		color: #f8f8f8;
		font-size: 1.1rem;
		margin: 0.75rem 0 0.25rem;
		font-weight: 500;
	}

	.pricing-card-amount {
		font-size: 3rem;
		font-weight: 700;
	}

	.pricing-card :global(.gradient-button) {
		margin-top: 0.5rem;
		padding: 0.75rem 2.5rem;
		font-size: 1.2rem;
	}

	.pricing-card-features {
		margin-top: 1rem;
		width: 100%;
		border-top: 1px solid rgba(255, 255, 255, 0.2);
		padding-top: 1rem;
	}

	.pricing-card-features-title {
		color: #f8f8f8;
		font-size: 0.9rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		margin: 0 0 0.5rem;
		text-align: left;
	}

	.pricing-card-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
		text-align: left;
	}

	.pricing-card-list li {
		color: #e0e0f0;
		font-size: 1rem;
		line-height: 1.3;
		padding-left: 1.2em;
		position: relative;
	}

	.pricing-card-list li::before {
		content: '✓';
		position: absolute;
		left: 0;
		color: #a9f3e1;
		font-weight: 700;
	}

	@media (min-width: 768px) {
		.pricing-card {
			max-width: 480px;
			padding: 2.5rem 2rem;
			gap: 0.6rem;
		}

		.pricing-card-badge {
			font-size: 1.5rem;
		}

		.pricing-card-title {
			font-size: 1.5rem;
		}

		.pricing-card-desc {
			font-size: 1.15rem;
		}

		.pricing-card-price {
			font-size: 1.3rem;
		}

		.pricing-card-amount {
			font-size: 3.5rem;
		}

		.pricing-card :global(.gradient-button) {
			font-size: 1.4rem;
			padding: 1rem 3rem;
		}

		.pricing-card-features-title {
			font-size: 1.05rem;
		}

		.pricing-card-list li {
			font-size: 1.15rem;
		}
	}
</style>
