---
import CurvedArrowIcon from './icons/CurvedArrowIcon.astro';
---

<section class="banner">
	<div class="banner-content">
		<h2 class="include-headline">
			<span class="include-title">¿Que incluye Valiant club?</span>
			<span class="include-subtitle">Te enseñamos como usan la IA los inmobiliarios más importantes del mundo</span>
		</h2>
		
		<div class="include-description">
			<div class="include-highlight-box">
				<p class="include-text highlight-box-text">
					La forma más rápida de aplicar IA como inmobiliario sin volverte experto.
				</p>
			</div>
			
			<div class="include-features">
				<div class="feature-box">
					<p class="include-text feature-text">
						En Valiant sabemos que la mayoría de los inmobiliarios dejan pasar las oportunidades por no decidir a tiempo.
					</p>
				</div>
				<div class="feature-box">
					<p class="include-text feature-text">
						Por eso, durante las proximas 2 horas, nuestra membresia incluyen acceso a todo esto:
					</p>
				</div>
			</div>
			
			<div class="include-arrow">
				<CurvedArrowIcon size="60" />
			</div>
		</div>
	</div>
</section>

<style>
	.banner {
		width: 100vw;
		position: relative;
		left: 50%;
		right: 50%;
		margin-left: -50vw;
		margin-right: -50vw;
		background-color: #4743da;
		padding: 2rem 0;
	}

	.banner-content {
		color: #f8f8f8;
		width: 100%;
		/* Replicate centered layout behavior */
		margin: 0 auto;
		padding: 0 0.5rem;
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
	}

	@media (min-width: 768px) {
		.banner-content {
			max-width: 80ch;
			padding: 0 1.5rem;
		}
	}

	.include-headline {
        display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: 0.8rem;
	}
    
	.include-title {
		font-size: 1.5rem;
		line-height: 1.2;
		font-weight: 700;
		color: white;
	}
    
	.include-subtitle {
		font-size: 1.1rem;
		line-height: 1.3;
		max-width: 800px;
		color: #e0e0e0;
	}
    
	.include-description {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		max-width: 750px; /* Aumentado para acomodar las dos cajas lado a lado */
		margin: 0 auto;
		margin-top: 1.5rem;
	}

	.include-highlight-box {
		background: linear-gradient(90deg, #cdfdf8, #94b9ff);
		border-radius: 0.5rem;
		padding: 0.7rem 1rem;
		margin-bottom: 0.5rem;
		transform: rotate(-2deg);
		box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
	}

	.include-features {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		width: 100%;
	}

	.feature-box {
		background-color: rgba(169, 243, 225, 0.1); /* #a9f3e1 0.1 opacity - casi transparente */
		border-radius: 0.5rem;
		padding: 0.5rem;
		flex: 1;
		display: flex;
		align-items: center;
		justify-content: center;
		border: 1px solid rgba(169, 243, 225, 0.2); /* Borde sutil para definir los limites */
	}

	.feature-text {
		color: #f0f0f0; /* Texto claro de nuevo para contraste sobre fondo oscuro */
		margin: 0;
		font-weight: 500;
		font-size: 0.95rem; /* Mas pequeño en mobile */
	}

	.highlight-box-text {
		color: black;
		font-weight: 700;
		font-size: 1.1rem;
		margin: 0;
	}
	
	.highlight-text {
		font-weight: 700;
		color: white;
		margin-top: 1rem;
	}
    
	@media (min-width: 768px) {
		.include-features {
			flex-direction: row;
			gap: 1.5rem;
		}

		/* Alineacion especifica para desktop */
		.feature-box:first-child .feature-text {
			text-align: right;
		}
		
		.feature-box:last-child .feature-text {
			text-align: left;
		}
		
		.include-title {
			font-size: 2.5rem;
		}
		.include-subtitle {
			font-size: 1.7rem;
		}
		.include-text {
			font-size: 1.5rem;
		}
		/* feature-text hereda de include-text, asi que lo sobrescribimos para que sea mas pequeño */
		.feature-text {
			font-size: 1.25rem;
		}
		.highlight-box-text {
			font-size: 2rem;
		}
	}

	.include-arrow {
		margin-top: 0.5rem;
		display: flex;
		justify-content: center;
		animation: bounce 2s infinite;
	}

	@keyframes bounce {
		0%, 20%, 50%, 80%, 100% {
			transform: translateY(0);
		}
		40% {
			transform: translateY(-10px);
		}
		60% {
			transform: translateY(-5px);
		}
	}
</style>

