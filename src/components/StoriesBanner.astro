---
import StoriesItems from './StoriesItems.astro';
import GradientButton from './GradientButton.astro';
---

<section class="stories-banner">
	<div class="stories-banner-content">
		<h2 class="stories-headline">
			<span class="stories-title">Historias <span class="stories-highlight">reales</span> de inmobiliariosreales.</span>
			<span class="stories-subtitle">Así es como Valiant ha cambiado la forma de operar el mercado inmobiliario con IA</span>
		</h2>
		<StoriesItems />
		<div class="stories-cta">
			<p class="stories-question">La pregunta es:</p>
			<p class="stories-question-big">¿Serás tú el <span class="stories-highlight">próximo</span>?</p>
			<p class="stories-cta-text">Estás por iniciar un nuevo año.<br>¿De verdad vas permitir ser el segundo en tu industria por <strong>no saber usar IA</strong>?</p>
			<GradientButton text="QUIERO SER EL NUMERO UNO" />
		</div>
	</div>
</section>

<style>
	.stories-banner {
		width: 100vw;
		position: relative;
		left: 50%;
		right: 50%;
		margin-left: -50vw;
		margin-right: -50vw;
		background-color: #4743da;
		padding: 2rem 0;
	}

	.stories-banner-content {
		color: #f8f8f8;
		width: 100%;
		margin: 0 auto;
		padding: 0 0.5rem;
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
	}

	@media (min-width: 768px) {
		.stories-banner-content {
			max-width: 80ch;
			padding: 0 1.5rem;
		}
	}

	.stories-headline {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: 0.8rem;
	}

	.stories-title {
		font-size: 1.5rem;
		line-height: 1.2;
		font-weight: 700;
		color: white;
	}

	.stories-highlight {
		background-color: #a9f3e1;
		color: #1a1a2e;
		border-radius: 0.25em;
		padding: 0.05em 0.25em;
	}

	.stories-subtitle {
		font-size: 1.1rem;
		line-height: 1.3;
		max-width: 800px;
		color: #e0e0e0;
		font-weight: 400;
	}

	@media (min-width: 768px) {
		.stories-title {
			font-size: 2.5rem;
			max-width: 25ch;
		}
		.stories-subtitle {
			font-size: 1.7rem;
			max-width: 35ch;
		}
	}

	.stories-cta {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: 0.3rem;
	}

	.stories-question {
		font-size: 1.25rem;
		color: #e0e0e0;
		margin: 0;
		font-weight: 400;
	}

	.stories-question-big {
		font-size: 1.5rem;
		font-weight: 700;
		color: white;
		margin: 0;
		line-height: 1.2;
	}

	.stories-cta-text {
		font-size: 1.05rem;
		color: #e0e0e0;
		margin: 1.3rem 0 0;
		line-height: 1.4;
		max-width: 35ch;
		font-weight: 400;
	}

	.stories-cta :global(.gradient-button) {
		margin-top: 1.25rem;
	}

	@media (min-width: 768px) {
		.stories-question {
			font-size: 1.7rem;
		}
		.stories-question-big {
			font-size: 2.5rem;
		}
		.stories-cta-text {
			font-size: 1.7rem;
			max-width: 30ch;
		}
	}
</style>
